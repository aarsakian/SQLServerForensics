{{define "schema"}}
<!DOCTYPE html>
<html>
<head>
    <title>Table Schema - {{.TableName}}</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 20px; background-color: #f4f4f4; }
        h1 { color: #333; }
        table { border-collapse: collapse; width: 100%; margin: 20px 0; background-color: white; box-shadow: 0 0 10px rgba(0,0,0,0.1); }
        th, td { border: 1px solid #ddd; padding: 12px; text-align: left; }
        th { background-color: #4CAF50; color: white; font-weight: bold; }
        tr:nth-child(even) { background-color: #f9f9f9; }
        tr:hover { background-color: #f1f1f1; }
    </style>
</head>
<body>
    <h1>Schema for {{.TableName}}</h1>
    <table>
        <thead>
            <tr>
                <th>Column Name</th>
                <th>Type</th>
                <th>Size</th>
                <th>Nullable</th>
                <th>Identity</th>
                <th>Computed</th>
                <th>Persisted</th>
                <th>Collation</th>
            </tr>
        </thead>
        <tbody>
            {{range .Columns}}
            <tr>
                <td>{{.Name}}</td>
                <td>{{.Type}}</td>
                <td>{{.Size}}</td>
                <td>{{if .IslNullable}}YES{{else}}NO{{end}}</td>
                <td>{{if .IsIdentity}}YES{{else}}NO{{end}}</td>
                <td>{{if .IsComputed}}YES{{else}}NO{{end}}</td>
                <td>{{if .IsPersisted}}YES{{else}}NO{{end}}</td>
                <td>{{.CollationId}}</td>
            </tr>
            {{end}}
        </tbody>
    </table>
</body>
</html>
{{end}}
