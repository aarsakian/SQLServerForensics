{{define "header"}}
<!DOCTYPE html>
<html>
<head>
    <title>Database Tables Index</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 20px; background-color: #f4f4f4; }
        h1 { color: #333; text-align: center; }
        table { border-collapse: collapse; width: 100%; margin: 20px 0; background-color: white; box-shadow: 0 0 10px rgba(0,0,0,0.1); }
        th, td { border: 1px solid #ddd; padding: 12px; text-align: left; }
        th { background-color: #4CAF50; color: white; font-weight: bold; }
        tr:nth-child(even) { background-color: #f9f9f9; }
        tr:hover { background-color: #f1f1f1; }
        a { color: #4CAF50; text-decoration: none; }
        a:hover { text-decoration: underline; }
        .page-numbers { font-family: monospace; font-size: 0.9em; min-width: 300px; }
        iframe { width: 100%; height: 600px; border: 1px solid #ddd; margin-top: 20px; }
    </style>
</head>
<body>
    <h1>Database {{.DatabaseName}} - Tables Index</h1>
    <table>
        <thead>
            <tr>
                <th>Table Name</th>
                <th>Type</th>
                <th>Page Numbers</th>
        <th> Links</th>
      
    </tr>
    </thead>
    <tbody>
{{end}}

{{define "row"}}
<tr>
    <td>{{.Name}}</td>
    <td>{{.Type}}</td>
    <td class="page-numbers">
        {{range $pageType, $pages := .PageIDsPerType}}
            <strong>{{$pageType}}:</strong> {{range $index, $page := $pages}}{{if $index}}, {{end}}{{$page}}{{end}}<br>
        {{end}}
    </td>
    <td>
        <ul>
            <li><a href="{{index .ExportPaths 0}}" target="_blank">Table Data</a></li>
            <li><a href="{{index .ExportPaths 1}}" target="_blank">Table Schema</a></li>

            {{range $i, $path := .ExportPaths}}
                {{if ge $i 2}}

                    {{/* Extract filename */}}
                    {{ $file := pathBase $path }}

                    {{/* Remove suffix */}}
                    {{ $clean := replaceAll $file  "_index.html"  ""    }}

                    <li>
                        <a href="{{$path}}" target="_blank">
                            Index {{$clean}} 
                        </a>
                    </li>

                {{end}}
            {{end}}
        </ul>
    </td>
</tr>
{{end}}


{{define "footer"}}
        </tbody>
    </table>
    <iframe name="table-frame" src="" title="Table Content"></iframe>
</body>
</html>
{{end}}