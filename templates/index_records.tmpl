{{define "header"}}
<!DOCTYPE html>
<html>
<head>
    <title>Index Records - {{.TableName}}</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 20px; background-color: #f4f4f4; }
        h1 { color: #333; text-align: center; }
        table { border-collapse: collapse; width: 100%; margin: 20px 0; background-color: white; box-shadow: 0 0 10px rgba(0,0,0,0.1); }
        th, td { border: 1px solid #ddd; padding: 12px; text-align: left; }
        th { background-color: #2196F3; color: white; font-weight: bold; }
        tr:nth-child(even) { background-color: #f9f9f9; }
        tr:hover { background-color: #f1f1f1; }
    </style>
</head>
<body>
    <h1>Index Records for {{.TableName}}</h1>
    <table>
        <thead>
            <tr>
                {{range .Headers}}<th>{{.}}</th>{{end}}
            </tr>
        </thead>
        <tbody>
{{end}}

{{define "row"}}
            <tr>
                {{range .}}<td>{{.}}</td>{{end}}
            </tr>
{{end}}

{{define "footer"}}
        </tbody>
    </table>
</body>
</html>
{{end}}