{{define "header"}}
<!DOCTYPE html>
<html>
<head>
<style>
body { font-family: sans-serif; margin: 20px; }
:root { --sticky-legend-top: 0px; --sticky-legend-height: 42px; }
table { border-collapse: collapse; width: 100%; }
th, td { border: 1px solid #ddd; padding: 12px; text-align: left; }
th {
	background-color: #f5f5f5;
	font-weight: bold;
	position: sticky;
	top: calc(var(--sticky-legend-top) + var(--sticky-legend-height));
	z-index: 20;
}
th .header-title { display: block; }
th .header-filter {
	width: 100%;
	margin-top: 8px;
	padding: 6px;
	box-sizing: border-box;
	border: 1px solid #bbb;
	border-radius: 4px;
	font-size: 12px;
}
th[data-sort-direction="asc"]::after { content: " ▲"; }
th[data-sort-direction="desc"]::after { content: " ▼"; }
tr:nth-child(even) { background-color: #fafafa; }
tr[data-is-carved="true"] td { background-color: #ffd6d6; }
tr[data-is-logged="true"] td { background-color: #fff6bf; }
h2 {justify-content: center; display: flex; color: #333; }
.page-nav { display: flex; gap: 12px; margin: 0 0 16px; font-size: 14px; align-items: center; justify-content: center; }
.page-nav-bottom { margin: 16px 0 0; }
.page-nav a,
.page-nav .page-nav-disabled {
	padding: 6px 12px;
	border: 1px solid transparent;
	border-radius: 6px;
	font-size: 14px;
	font-weight: 600;
	line-height: 1.25;
	text-decoration: none;
	transition: background-color 150ms ease, border-color 150ms ease, box-shadow 150ms ease;
}
.page-nav .page-nav-prev {
	border-color: #cbd5e1;
	background: #f8fafc;
	color: #334155;
	box-shadow: 0 1px 2px rgb(15 23 42 / 8%);
}
.page-nav .page-nav-prev:hover {
	border-color: #94a3b8;
	background: #f1f5f9;
}
.page-nav .page-nav-next {
	border-color: #0f766e;
	background: #0f766e;
	color: #fff;
	box-shadow: 0 1px 2px rgb(15 23 42 / 12%);
}
.page-nav .page-nav-next:hover {
	border-color: #115e59;
	background: #115e59;
	box-shadow: 0 2px 4px rgb(15 23 42 / 16%);
}
.page-nav .page-nav-prev:focus-visible,
.page-nav .page-nav-next:focus-visible {
	outline: 2px solid #5eead4;
	outline-offset: 2px;
}
.page-nav .page-nav-prev:active { background: #e2e8f0; }
.page-nav .page-nav-next:active { background: #134e4a; }
.page-nav .page-nav-disabled { color: #999; border-color: #ddd; background: #fafafa; }
.page-nav .page-nav-current { font-weight: 700; letter-spacing: 0.02em; margin: 0 12px; }
.page-jump { display: flex; align-items: center; gap: 6px; }
.page-picker { position: relative; display: inline-flex; }
.page-picker input {
	width: 5em;
	padding: 6px 8px;
	border: 1px solid #cbd5e1;
	border-right: 0;
	border-radius: 6px 0 0 6px;
}
.page-picker-toggle {
	padding: 6px 9px;
	border: 1px solid #cbd5e1;
	border-radius: 0 6px 6px 0;
	background: #f8fafc;
	color: #475569;
	cursor: pointer;
}
.page-picker-toggle:hover { background: #e2e8f0; }
.page-picker-toggle:focus-visible,
.page-picker input:focus-visible {
	position: relative;
	z-index: 1;
	outline: 2px solid #818cf8;
	outline-offset: 1px;
}
.page-picker-menu {
	position: absolute;
	top: calc(100% + 4px);
	right: 0;
	z-index: 40;
	display: flex;
	flex-direction: column;
	min-width: 100%;
	max-height: 220px;
	overflow-y: auto;
	padding: 4px;
	border: 1px solid #cbd5e1;
	border-radius: 6px;
	background: #fff;
	box-shadow: 0 8px 16px rgb(15 23 42 / 14%);
}
.page-picker-menu[hidden] { display: none; }
.page-picker-option {
	padding: 6px 10px;
	border: 0;
	border-radius: 4px;
	background: transparent;
	color: #334155;
	text-align: left;
	cursor: pointer;
}
.page-picker-option:hover,
.page-picker-option[aria-selected="true"] { background: #eef2ff; color: #3730a3; }
.page-jump button[type="submit"] {
	padding: 6px 14px;
	border: 1px solid #4f46e5;
	border-radius: 6px;
	background: #4f46e5;
	color: #fff;
	font-size: 14px;
	font-weight: 600;
	line-height: 1.25;
	box-shadow: 0 1px 2px rgb(0 0 0 / 10%);
	cursor: pointer;
	transition: background-color 150ms ease, border-color 150ms ease, box-shadow 150ms ease;
}
.page-jump button[type="submit"]:hover {
	border-color: #4338ca;
	background: #4338ca;
	box-shadow: 0 2px 4px rgb(0 0 0 / 15%);
}
.page-jump button[type="submit"]:focus-visible {
	outline: 2px solid #818cf8;
	outline-offset: 2px;
}
.page-jump button[type="submit"]:active {
	background: #3730a3;
}
.page-jump-error { color: #b00020; }
.row-legend {
	display: flex;
	justify-content: center;
	gap: 16px;
	margin: 10px 0 14px;
	font-size: 13px;
	color: #333;
}
.row-legend-item {
	display: inline-flex;
	align-items: center;
	gap: 8px;
}
.row-legend-swatch {
	width: 16px;
	height: 16px;
	display: inline-block;
	border: 1px solid #bbb;
	border-radius: 3px;
}
.row-legend-swatch-carved { background-color: #ffd6d6; }
.row-legend-swatch-logged { background-color: #fff6bf; }
.row-legend-top {
	position: sticky;
	top: var(--sticky-legend-top);
	z-index: 30;
	background: #fff;
	padding: 8px 0;
	border-bottom: 1px solid #eee;
}
</style>
</head>
<body>
<h2>Table {{.Name}}</h2>
{{if and .IsPaginated (or .PrevPage .NextPage)}}
<nav class="page-nav">
{{if .PrevPage}}<a class="page-nav-prev" href="{{.PrevPage}}">&lsaquo; Prev</a>{{else}}<span class="page-nav-disabled">&lsaquo; Prev</span>{{end}}
{{if .CurPage}}<strong class="page-nav-current">Page {{.CurPage}}</strong>{{end}}
{{if .NextPage}}<a class="page-nav-next" href="{{.NextPage}}">Next &rsaquo;</a>{{else}}<span class="page-nav-disabled">Next &rsaquo;</span>{{end}}
<form class="page-jump" data-page-prefix="{{.Name}}" data-page-count="{{.PageCount}}">
<label>Go to page
<span class="page-picker">
<input type="text" name="page" inputmode="numeric" value="{{.CurPage}}" required>
<button class="page-picker-toggle" type="button" aria-label="Show page list" aria-expanded="false">&#9662;</button>
<span class="page-picker-menu" role="listbox" hidden></span>
</span>
</label>
<button type="submit">Go</button>
<span class="page-jump-error" role="alert" aria-live="polite"></span>
</form>
</nav>
{{end}}

<div class="row-legend row-legend-top" aria-label="Row color legend">
<span class="row-legend-item"><span class="row-legend-swatch row-legend-swatch-carved"></span>Carved record</span>
<span class="row-legend-item"><span class="row-legend-swatch row-legend-swatch-logged"></span>Logged record</span>
</div>

<table>
<thead>
<tr>{{ range .Headers }}<th>{{ . }}</th>{{ end }}</tr>
</thead>
<tbody>
{{end}}

{{define "row"}}
<tr data-is-logged="{{.Row.Logged}}" data-is-carved="{{.Row.Carved}}">{{ range .Row.Vals }}<td>{{ . }}</td>{{ end }}
{{if .IncludeLogInfo}}
<td>{{.Row.LoggedOperation}}</td>
{{end}}
{{if .IncludePageInfo}}
	<td>
   {{range $index, $pages:=.Row.PageInfo}}
    	{{.}}
	    {{if eq $index 0}}
			:
		{{end}}
	  
   {{end}}
    </td>
{{end}}

</tr>
{{end}}

{{define "footer"}}

</tbody>
</table>

<div class="row-legend" aria-label="Row color legend">
<span class="row-legend-item"><span class="row-legend-swatch row-legend-swatch-carved"></span>Carved record</span>
<span class="row-legend-item"><span class="row-legend-swatch row-legend-swatch-logged"></span>Logged record</span>
</div>
{{if and .IsPaginated (or .PrevPage .NextPage)}}
<nav class="page-nav page-nav-bottom">
{{if .PrevPage}}<a class="page-nav-prev" href="{{.PrevPage}}">&lsaquo; Prev</a>{{else}}<span class="page-nav-disabled">&lsaquo; Prev</span>{{end}}
{{if .CurPage}}<strong class="page-nav-current">Page {{.CurPage}}</strong>{{end}}
{{if .NextPage}}<a class="page-nav-next" href="{{.NextPage}}">Next &rsaquo;</a>{{else}}<span class="page-nav-disabled">Next &rsaquo;</span>{{end}}
<form class="page-jump" data-page-prefix="{{.Name}}" data-page-count="{{.PageCount}}">
<label>Go to page
<span class="page-picker">
<input type="text" name="page" inputmode="numeric" value="{{.CurPage}}" required>
<button class="page-picker-toggle" type="button" aria-label="Show page list" aria-expanded="false">&#9662;</button>
<span class="page-picker-menu" role="listbox" hidden></span>
</span>
</label>
<button type="submit">Go</button>
<span class="page-jump-error" role="alert" aria-live="polite"></span>
</form>
</nav>
{{end}}

{{if not .IsPaginated}}
<script>
(() => {
	const table = document.querySelector("table");
	if (!table) return;

	const headers = table.querySelectorAll("thead th");
	const tbody = table.querySelector("tbody");
	if (!headers.length || !tbody) return;

	headers.forEach((header) => {
		header.style.cursor = "pointer";
		header.style.userSelect = "none";
	});

	const rows = Array.from(tbody.querySelectorAll("tr"));

	const getCellText = (row, columnIndex) =>
		(row.children[columnIndex]?.textContent || "").trim();

	const updateColumnAutocomplete = (columnIndex, datalistId) => {
		const values = new Set();
		rows.forEach((row) => {
			if (row.style.display === "none") return;
			const value = getCellText(row, columnIndex);
			if (value) values.add(value);
		});

		const datalist = document.getElementById(datalistId);
		if (!datalist) return;
		datalist.innerHTML = "";

		Array.from(values)
			.sort((a, b) => a.localeCompare(b, undefined, { numeric: true, sensitivity: "base" }))
			.forEach((value) => {
				const option = document.createElement("option");
				option.value = value;
				datalist.appendChild(option);
			});
	};

	const applyFilters = () => {
		const filters = Array.from(headers).map((header) => {
			const input = header.querySelector(".header-filter");
			return (input?.value || "").trim().toLowerCase();
		});

		rows.forEach((row) => {
			const visible = filters.every((filterValue, columnIndex) => {
				if (!filterValue) return true;
				const cellValue = getCellText(row, columnIndex).toLowerCase();
				return cellValue.includes(filterValue);
			});
			row.style.display = visible ? "" : "none";
		});

		headers.forEach((_, columnIndex) => {
			updateColumnAutocomplete(columnIndex, `header-filter-options-${columnIndex}`);
		});
	};

	headers.forEach((header, columnIndex) => {
		const title = (header.textContent || "").trim();
		header.textContent = "";

		const titleSpan = document.createElement("span");
		titleSpan.className = "header-title";
		titleSpan.textContent = title;
		header.appendChild(titleSpan);

		const datalistId = `header-filter-options-${columnIndex}`;
		const datalist = document.createElement("datalist");
		datalist.id = datalistId;
		header.appendChild(datalist);

		const input = document.createElement("input");
		input.className = "header-filter";
		input.type = "search";
		input.placeholder = "Search...";
		input.setAttribute("list", datalistId);
		input.addEventListener("click", (event) => event.stopPropagation());
		input.addEventListener("keydown", (event) => event.stopPropagation());
		input.addEventListener("input", applyFilters);
		header.appendChild(input);

		updateColumnAutocomplete(columnIndex, datalistId);

		header.addEventListener("click", () => {
			const current = header.getAttribute("data-sort-direction");
			const direction = current === "asc" ? "desc" : "asc";

			headers.forEach((h) => h.removeAttribute("data-sort-direction"));
			header.setAttribute("data-sort-direction", direction);

			rows.sort((rowA, rowB) => {
				const textA = getCellText(rowA, columnIndex);
				const textB = getCellText(rowB, columnIndex);

				const numA = Number(textA);
				const numB = Number(textB);
				const bothNumeric = !Number.isNaN(numA) && !Number.isNaN(numB);

				let comparison = 0;
				if (bothNumeric) {
					comparison = numA - numB;
				} else {
					comparison = textA.localeCompare(textB, undefined, {
						numeric: true,
						sensitivity: "base",
					});
				}

				return direction === "asc" ? comparison : -comparison;
			});

			rows.forEach((row) => tbody.appendChild(row));
			applyFilters();
		});
	});

	applyFilters();
})();
</script>
{{end}}
{{if .IsPaginated}}
<script>
document.querySelectorAll(".page-jump").forEach((form) => {
	const pageInput = form.querySelector('input[name="page"]');
	const picker = form.querySelector(".page-picker");
	const toggle = form.querySelector(".page-picker-toggle");
	const menu = form.querySelector(".page-picker-menu");
	const pageCount = Number(form.dataset.pageCount);
	const errorMessage = form.querySelector(".page-jump-error");
	if (!pageInput || !picker || !toggle || !menu || !Number.isInteger(pageCount) || pageCount < 1) return;

	for (let page = 1; page <= pageCount; page++) {
		const option = document.createElement("button");
		option.type = "button";
		option.className = "page-picker-option";
		option.setAttribute("role", "option");
		option.textContent = `Page ${page}`;
		option.setAttribute("aria-selected", String(page === Number(pageInput.value)));
		option.addEventListener("click", () => {
			pageInput.value = String(page);
			window.location.href = `${form.dataset.pagePrefix}_${page - 1}.html`;
		});
		menu.appendChild(option);
	}

	toggle.addEventListener("click", () => {
		menu.hidden = !menu.hidden;
		toggle.setAttribute("aria-expanded", String(!menu.hidden));
		if (!menu.hidden) {
			menu.querySelector(`[aria-selected="true"]`)?.scrollIntoView({ block: "nearest" });
		}
	});

	document.addEventListener("click", (event) => {
		if (!picker.contains(event.target)) {
			menu.hidden = true;
			toggle.setAttribute("aria-expanded", "false");
		}
	});

	pageInput.addEventListener("input", () => {
		const page = Number(pageInput.value);
		menu.querySelectorAll(".page-picker-option").forEach((option, index) => {
			option.setAttribute("aria-selected", String(index + 1 === page));
		});
		if (errorMessage) {
			errorMessage.textContent = Number.isInteger(page) && (page < 1 || page > pageCount)
				? `Enter a whole page number from 1 to ${pageCount}.`
				: "";
		}
	});

	form.addEventListener("submit", (event) => {
		event.preventDefault();
		const page = Number(pageInput.value);
		if (!Number.isInteger(page) || page < 1 || page > pageCount) {
			if (errorMessage) errorMessage.textContent = `Enter a whole page number from 1 to ${pageCount}.`;
			return;
		}
		if (errorMessage) errorMessage.textContent = "";
		window.location.href = `${form.dataset.pagePrefix}_${page - 1}.html`;
	});
});
</script>
{{end}}
</body>
</html>
{{end}}